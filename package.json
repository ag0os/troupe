{
  "name": "troupe",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./lib/index.ts",
    "./declaration": "./lib/entries/declaration.ts",
    "./cli": "./lib/entries/cli.ts",
    "./runtime": "./lib/entries/runtime.ts",
    "./compiler": "./lib/entries/compiler.ts",
    "./provenance": "./lib/entries/provenance.ts",
    "./testing": "./lib/entries/testing.ts",
    "./text-imports": {
      "types": "./lib/text-imports.d.ts"
    }
  },
  "scripts": {
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile-all.ts",
    "watch": "bun scripts/watch-agents.ts",
    "evals:shepherd": "bun evals/shepherd/run.ts",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:all": "bun run typecheck && bun run check",
    "lint:fix": "biome check --write --unsafe .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "^2.1.2",
    "husky": "^9.1.6"
  },
  "dependencies": {
    "typescript": "^5.6.2",
    "yaml": "^2",
    "zod": "^4"
  }
}
